# Trivy vulnerability ignore list
#
# Each entry is explicitly classified. No entry is silently ignored.
# The ignore-unfixed flag in the workflow skips vulnerabilities with
# no available fix. This file documents remaining classified findings.
#
# Classification key:
#   will_not_fix     = upstream has declared no fix will be provided
#   fix_deferred     = upstream has deferred fix to a future release
#   base_image       = vulnerability in the base Node.js image, not in
#                      Cashmemo production dependencies

# zlib1g: integer overflow, heap-based buffer overflow
# will_not_fix: upstream zlib has stated this is not a vulnerability in
# the zlib library as used in Debian. Debian marks as will_not_fix.
CVE-2023-45853

# gzip: global buffer overflow
# fix_deferred: no fix available yet for Debian 12 bookworm
CVE-2026-41992

# perl-archive-tar: path traversal
# fix_deferred: no fix available yet for Debian 12 bookworm
CVE-2026-42496

# perl-archive-tar: arbitrary file overwrite
# fix_deferred: no fix available yet for Debian 12 bookworm
CVE-2026-42497

# perl-archive-tar: denial of service
# fix_deferred: no fix available yet for Debian 12 bookworm
CVE-2026-9538

# Verifier image only: bundled npm/corepack in Node.js base image
# The verifier is a development/staging-only image that requires pnpm
# and dev dependencies to run test suites. It is never deployed as
# production. These CVEs are in the base image's bundled npm packages
# (tar, minimatch, picomatch, sigstore, ip-address) and Go stdlib in
# esbuild — not in Cashmemo production code.
# Classification: base_image_dev_only — verifier image, not production

# node-tar: DoS via gzip bomb
CVE-2026-59873
# node-tar: arbitrary file read/write
CVE-2026-26960
# node-tar: hardlink path traversal
CVE-2026-29786
# tar: file overwrite via symlink
CVE-2026-31802
# node-tar: DoS via malformed archive
CVE-2026-59874
# minimatch: DoS via specially crafted pattern
CVE-2026-26996
# minimatch: DoS via unbounded backtracking
CVE-2026-27903
# minimatch: catastrophic backtracking
CVE-2026-27904
# picomatch: ReDoS
CVE-2026-33671
# sigstore: unauthorized certificates
CVE-2026-48815
# ip-address: inconsistent parsing
CVE-2026-69192


{
  "contract": "cashmemo-openapi-v1",
  "operations": {
    "GET /v1/auth/session": ["200", "401", "503"],
    "POST /v1/money-memos": ["200", "201", "409", "422", "503"],
    "POST /v1/money-memos/query": ["200", "409", "422"],
    "GET /v1/money-memos/{memoId}": ["200", "404"],
    "PUT /v1/money-memos/{memoId}": ["200", "404", "409", "422"],
    "POST /v1/money-memos/{memoId}/archive": ["200", "404", "409"],
    "POST /v1/money-memos/{memoId}/restore": ["200", "404", "409"],
    "POST /v1/money-memos/{memoId}/delete": ["200", "404", "409"],
    "POST /v1/recently-deleted/query": ["200", "409", "422"],
    "POST /v1/recently-deleted/{memoId}/restore": ["200", "404", "409"],
    "POST /v1/recently-deleted/{memoId}/purge": ["204", "404", "409", "503"],
    "POST /v1/labels/query": ["200", "422"],
    "POST /v1/labels": ["201", "409", "422"],
    "PUT /v1/labels/{labelId}": ["200", "404", "409", "422"],
    "POST /v1/labels/{labelId}/deactivate": ["200", "404", "409"],
    "POST /v1/labels/{labelId}/reactivate": ["200", "404", "409"],
    "POST /v1/labels/{labelId}/purge": ["204", "404", "409"],
    "POST /v1/exports/money-memos": ["200", "409", "503"],
    "GET /v1/reference/currencies": ["200", "401"]
  },
  "schemas": {
    "AuthenticatedSession": { "required": ["accountId"] },
    "MoneyMemoType": { "enum": ["income", "expense"] },
    "PlannedStatus": { "enum": ["planned", "unplanned"] },
    "Purpose": { "enum": ["personal", "work", "mixed"] },
    "LifecycleStatus": { "enum": ["active", "archived", "pending_deletion"] },
    "LabelKind": { "enum": ["category", "money_space"] },
    "LabelState": { "enum": ["active", "deactivated"] },
    "OccurrenceCreate": { "required": ["instant", "localWallTime", "utcOffset"] },
    "MoneyMemoCreateRequest": {
      "required": ["amount", "categoryId", "creationId", "currency", "moneySpaceId", "occurrence", "plannedStatus", "purpose", "type"]
    },
    "MoneyMemoEditRequest": {
      "required": ["amount", "categoryId", "currency", "expectedRevision", "moneySpaceId", "occurrence", "plannedStatus", "purpose", "type"]
    },
    "RevisionRequest": { "required": ["expectedRevision"] },
    "MoneyMemo": {
      "required": ["amount", "amountMinorUnitScale", "category", "createdAt", "currency", "id", "lifecycleStatus", "moneySpace", "note", "occurrence", "plannedStatus", "purgeDeadline", "purpose", "revision", "type", "updatedAt"]
    },
    "LabelReference": { "required": ["id", "name", "state"] },
    "Label": { "required": ["createdAt", "id", "kind", "name", "revision", "state", "updatedAt"] },
    "MoneyMemoPage": { "required": ["items", "nextPagePosition", "resultSetVersion"] },
    "SafeDetectorId": {
      "enum": ["B1_PAN_LUHN", "B2_IBAN_MOD97", "B3_LABELED_ACCOUNT", "B4_LABELED_ROUTING", "B5_LABELED_CARD_SECRET", "B6_LABELED_BANK_CREDENTIAL", "B7_LABELED_BANK_TOKEN", "B8_STATEMENT_PASTE", "B9_LABELED_GOV_ID"]
    },
    "FieldError": { "required": ["field", "message", "rule"] },
    "ErrorResponse": { "required": ["code", "message", "requestId", "retryable"] }
  }
}

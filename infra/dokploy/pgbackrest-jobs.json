{
  "schemaVersion": "cashmemo-pgbackrest-jobs-v1",
  "imageIdentity": "ghcr.io/vellixia/cashmemo-pgbackrest@sha256:REQUIRED",
  "jobs": [
    {
      "id": "repository-check",
      "schedule": "*/15 * * * *",
      "arguments": ["check"]
    },
    {
      "id": "differential-backup",
      "schedule": "17 1 * * 1-6",
      "arguments": ["backup-diff"]
    },
    {
      "id": "full-backup",
      "schedule": "17 1 * * 0",
      "arguments": ["backup-full"]
    },
    {
      "id": "repository-expire",
      "schedule": "47 2 * * *",
      "arguments": ["expire"]
    }
  ],
  "walArchiving": {
    "postgresqlArchiveMode": "on",
    "archiveCommand": "node /usr/local/lib/cashmemo/pgbackrest-entrypoint.mjs archive-push %p",
    "requiresPgBackRestClientInsidePostgreSQLRuntime": true,
    "existingPostgreSQLImageIncludesClient": false,
    "deploymentStatus": "BLOCKED_POSTGRES_ARCHIVE_CLIENT_COLOCATION",
    "proofRequired": true
  }
}

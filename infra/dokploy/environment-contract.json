{
  "schemaVersion": "cashmemo-workload-environment-v2",
  "delivery": "runtime-injected-environment",
  "imageProvided": {
    "runtime": ["BUILD_VERSION"],
    "api": ["PROCESS_ROLE", "PORT"],
    "worker": ["PROCESS_ROLE", "PORT"],
    "verifier": ["CASHMEMO_IMAGE_REVISION"]
  },
  "api": {
    "required": [
      "APP_ENV",
      "APP_ORIGIN",
      "DATABASE_URL",
      "AUTH_DATABASE_URL",
      "AUTH_SESSION_SECRET",
      "AUTH_TOKEN_HMAC_KEY",
      "PASSWORD_PEPPER",
      "EVIDENCE_HMAC_KEY",
      "DELETION_SUPPRESSION_HMAC_KEY",
      "SECRET_DELIVERY_MODE",
      "OBJECT_STORAGE_MODE",
      "RUSTFS_PRIMARY_ENDPOINT",
      "RUSTFS_PRIMARY_REGION",
      "RUSTFS_PRIMARY_ACCESS_KEY",
      "RUSTFS_PRIMARY_SECRET_KEY",
      "RUSTFS_PRIMARY_STORAGE_POLICY_VERSION",
      "RUSTFS_EXPORT_BUCKET",
      "RUSTFS_EVIDENCE_BUCKET",
      "BACKUP_MODE",
      "RUSTFS_SECONDARY_ENDPOINT",
      "RUSTFS_SECONDARY_REGION",
      "RUSTFS_SECONDARY_ACCESS_KEY",
      "RUSTFS_SECONDARY_SECRET_KEY",
      "RUSTFS_SECONDARY_STORAGE_POLICY_VERSION",
      "RUSTFS_SECONDARY_BUCKET",
      "PGBACKREST_STANZA",
      "PGBACKREST_REPOSITORY_PREFIX",
      "DELETION_LEDGER_NAMESPACE",
      "EMAIL_PROVIDER",
      "EMAIL_FROM_ADDRESS",
      "ASSISTED_CAPTURE_MODE",
      "STT_MODEL_SNAPSHOT",
      "EXTRACTION_MODEL_SNAPSHOT",
      "PROVIDER_DECISION_VERSION",
      "CURRENCY_REGISTRY_VERSION",
      "TZDB_VERSION",
      "OTEL_EXPORTER_OTLP_ENDPOINT"
    ]
  },
  "worker": {
    "required": ["APP_ENV", "DATABASE_URL", "SECRET_DELIVERY_MODE"],
    "forbidden": [
      "AUTH_DATABASE_URL",
      "AUTH_SESSION_SECRET",
      "AUTH_TOKEN_HMAC_KEY",
      "PASSWORD_PEPPER",
      "CLOUDFLARE_EMAIL_API_TOKEN",
      "OPENAI_API_KEY",
      "RUSTFS_PRIMARY_SECRET_KEY",
      "RUSTFS_SECONDARY_SECRET_KEY",
      "PGBACKREST_REPOSITORY_CIPHER_PASS"
    ]
  },
  "migration": {
    "required": ["DATABASE_URL"],
    "credentialClass": "migration-only"
  },
  "pgBackRest": {
    "required": [
      "PGBACKREST_STANZA",
      "PGBACKREST_PG1_PATH",
      "PGBACKREST_REPOSITORY_BUCKET",
      "PGBACKREST_REPOSITORY_PREFIX",
      "PGBACKREST_REPOSITORY_CIPHER_PASS",
      "RUSTFS_SECONDARY_ENDPOINT",
      "RUSTFS_SECONDARY_REGION",
      "RUSTFS_SECONDARY_ACCESS_KEY",
      "RUSTFS_SECONDARY_SECRET_KEY"
    ],
    "credentialClass": "backup-only"
  },
  "verifier": {
    "required": [
      "APP_ENV",
      "CASHMEMO_SYNTHETIC_VERIFICATION",
      "CASHMEMO_EXTERNAL_TEST_DATABASE_URL",
      "RUSTFS_PRIMARY_ENDPOINT",
      "RUSTFS_PRIMARY_REGION",
      "RUSTFS_PRIMARY_ACCESS_KEY",
      "RUSTFS_PRIMARY_SECRET_KEY",
      "RUSTFS_EXPORT_BUCKET",
      "RUSTFS_EVIDENCE_BUCKET",
      "RUSTFS_SECONDARY_ENDPOINT",
      "RUSTFS_SECONDARY_REGION",
      "RUSTFS_SECONDARY_ACCESS_KEY",
      "RUSTFS_SECONDARY_SECRET_KEY",
      "RUSTFS_SECONDARY_BUCKET",
      "PGBACKREST_REPOSITORY_BUCKET",
      "OTEL_EXPORTER_OTLP_ENDPOINT"
    ],
    "storiesAdditional": [
      "AUTH_SESSION_SECRET",
      "AUTH_TOKEN_HMAC_KEY",
      "PASSWORD_PEPPER",
      "EVIDENCE_HMAC_KEY",
      "DELETION_SUPPRESSION_HMAC_KEY",
      "SECRET_DELIVERY_MODE",
      "OBJECT_STORAGE_MODE",
      "RUSTFS_PRIMARY_STORAGE_POLICY_VERSION",
      "BACKUP_MODE",
      "RUSTFS_SECONDARY_STORAGE_POLICY_VERSION",
      "PGBACKREST_STANZA",
      "PGBACKREST_REPOSITORY_PREFIX",
      "DELETION_LEDGER_NAMESPACE",
      "EMAIL_PROVIDER",
      "EMAIL_FROM_ADDRESS",
      "ASSISTED_CAPTURE_MODE",
      "STT_MODEL_SNAPSHOT",
      "EXTRACTION_MODEL_SNAPSHOT",
      "PROVIDER_DECISION_VERSION",
      "CURRENCY_REGISTRY_VERSION",
      "TZDB_VERSION"
    ],
    "productionAllowed": false,
    "dataClass": "synthetic-only"
  }
}

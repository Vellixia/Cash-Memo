# Dokploy interpolation. Production image values must include immutable digests.
CASHMEMO_V1_HOST=cashmemo.example
CASHMEMO_V1_DOKPLOY_NETWORK=dokploy-network
CASHMEMO_V1_PRIVATE_NETWORK=cashmemo-v1-private
CASHMEMO_V1_API_IMAGE=registry.example/cashmemo-v1-api@sha256:replace-with-deployed-digest
CASHMEMO_V1_WEB_IMAGE=registry.example/cashmemo-v1-web@sha256:replace-with-deployed-digest
CASHMEMO_V1_POSTGRES_IMAGE=postgres:18.4-alpine@sha256:replace-with-reviewed-digest
CASHMEMO_V1_POSTGRES_VOLUME=cashmemo-v1-postgres-data

# Isolated V1 PostgreSQL. URL-encode credentials embedded in DATABASE_URL.
CASHMEMO_V1_POSTGRES_DB=cashmemo_v1
CASHMEMO_V1_POSTGRES_USER=cashmemo_v1
CASHMEMO_V1_POSTGRES_PASSWORD=replace-with-generated-secret
CASHMEMO_V1_DATABASE_URL=postgres://cashmemo_v1:replace-with-url-encoded-secret@cashmemo-v1-postgres:5432/cashmemo_v1

# API serve scope. Receipt and backup credentials are intentionally absent. BIND_ADDR is required
# for container reachability; Argon2 controls are benchmarked/tuned on the production host.
CASHMEMO_V1_PUBLIC_ORIGIN=https://cashmemo.example
CASHMEMO_V1_COOKIE_SECURE=true
CASHMEMO_V1_SESSION_IDLE_SECONDS=604800
CASHMEMO_V1_SESSION_ABSOLUTE_SECONDS=2592000
CASHMEMO_V1_SESSION_TOUCH_SECONDS=3600
CASHMEMO_V1_SMTP_HOST=smtp.example
CASHMEMO_V1_SMTP_PORT=587
CASHMEMO_V1_SMTP_SECURITY=starttls
CASHMEMO_V1_SMTP_USERNAME=replace-with-smtp-user
CASHMEMO_V1_SMTP_PASSWORD=replace-with-smtp-password
CASHMEMO_V1_SMTP_FROM=cashmemo@example.com
CASHMEMO_V1_APP_ENV=production
CASHMEMO_V1_LOG_LEVEL=info
CASHMEMO_V1_AUTH_WINDOW_SECS=60
CASHMEMO_V1_AUTH_MAX_KEYS=10000
CASHMEMO_V1_AUTH_REGISTER_LIMIT=5
CASHMEMO_V1_AUTH_VERIFICATION_RESEND_LIMIT=5
CASHMEMO_V1_AUTH_LOGIN_LIMIT=5
CASHMEMO_V1_AUTH_RESET_REQUEST_LIMIT=5
# Exact CIDRs for Traefik's Docker edge-network address and every approved upstream proxy hop.
# Empty trusts nobody in the API, but Dokploy Compose requires a nonempty production value.
CASHMEMO_V1_TRUSTED_PROXY_CIDRS=replace-with-exact-proxy-cidrs
# Empty means Traefik trusts no inbound X-Forwarded-* source. Set only for an approved LB/CDN.
CASHMEMO_V1_TRAEFIK_TRUSTED_FORWARDER_CIDRS=
CASHMEMO_V1_ARGON2_MEMORY_KIB=65536
CASHMEMO_V1_ARGON2_TIME_COST=3
CASHMEMO_V1_ARGON2_PARALLELISM=1

# Purge-accounts schedule only. Add these to that command, never web/API serve.
CASHMEMO_V1_DELETION_RECEIPT_S3_ENDPOINT=https://receipts.example
CASHMEMO_V1_DELETION_RECEIPT_S3_REGION=replace-with-region
CASHMEMO_V1_DELETION_RECEIPT_S3_BUCKET=replace-with-dedicated-bucket
CASHMEMO_V1_DELETION_RECEIPT_S3_PREFIX=cashmemo-v1/deletion-receipts
CASHMEMO_V1_DELETION_RECEIPT_S3_ACCESS_KEY_ID=replace-with-narrow-access-key
CASHMEMO_V1_DELETION_RECEIPT_S3_SECRET_ACCESS_KEY=replace-with-narrow-secret-key
CASHMEMO_V1_DELETION_RECEIPT_HMAC_KEYS=1:replace-with-at-least-64-hex-characters

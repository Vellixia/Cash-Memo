{
  "name": "cashmemo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "acceptance:full-mvp": "node scripts/verify/run-gates.mjs acceptance full-mvp",
    "acceptance:us1": "node scripts/verify/run-gates.mjs acceptance us1",
    "acceptance:us2": "node scripts/verify/run-gates.mjs acceptance us2",
    "acceptance:us3": "node scripts/verify/run-gates.mjs acceptance us3",
    "acceptance:us4": "node scripts/verify/run-gates.mjs acceptance us4",
    "acceptance:us5": "node scripts/verify/run-gates.mjs acceptance us5",
    "acceptance:us6": "node scripts/verify/run-gates.mjs acceptance us6",
    "acceptance:us7": "node scripts/verify/run-gates.mjs acceptance us7",
    "acceptance:us8": "node scripts/verify/run-gates.mjs acceptance us8",
    "architecture:check": "node scripts/verify/run-gates.mjs architecture",
    "build": "node scripts/verify/run-gates.mjs workspace build",
    "contracts:check": "node scripts/verify/run-gates.mjs contracts",
    "contracts:generate": "openapi-ts --file packages/contracts/openapi-codegen.config.mjs",
    "db:generate": "node scripts/verify/run-gates.mjs database generate",
    "db:migrate": "node scripts/verify/run-gates.mjs database migrate",
    "db:reset:local": "node scripts/verify/run-gates.mjs database reset-local",
    "db:seed:synthetic": "node scripts/verify/run-gates.mjs database seed-synthetic",
    "db:verify": "node scripts/verify/run-gates.mjs database verify",
    "dev": "node scripts/verify/run-gates.mjs dev manual",
    "dev:fake-providers": "node scripts/verify/run-gates.mjs dev fake",
    "dev:manual": "node scripts/verify/run-gates.mjs dev manual",
    "dev:real-providers": "node scripts/verify/run-gates.mjs dev real",
    "env:check": "node scripts/verify/run-gates.mjs environment check",
    "env:init:local": "node scripts/verify/run-gates.mjs environment init-local",
    "evidence:verify": "node scripts/verify/run-gates.mjs evidence",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:acceptance": "node scripts/verify/run-gates.mjs gate acceptance",
    "gate:format-lint": "node scripts/verify/run-gates.mjs gate format-lint",
    "gate:integration-contract": "node scripts/verify/run-gates.mjs gate integration-contract",
    "gate:privacy-security": "node scripts/verify/run-gates.mjs gate privacy-security",
    "gate:typecheck-drift": "node scripts/verify/run-gates.mjs gate typecheck-drift",
    "gate:unit-property": "node scripts/verify/run-gates.mjs gate unit-property",
    "gates:list": "node scripts/verify/run-gates.mjs list",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "local:cert": "node scripts/local/bootstrap-https.mjs",
    "local:down": "docker compose -f infra/containers/compose.yaml down",
    "local:up": "node scripts/local/bootstrap-https.mjs && docker compose -f infra/containers/compose.yaml up -d --wait",
    "preview:https": "node scripts/verify/run-gates.mjs workspace preview:https",
    "release": "node scripts/verify/run-gates.mjs release",
    "test:acceptance": "node scripts/verify/run-gates.mjs stories",
    "test:auth:better-auth-compat": "node scripts/verify/run-gates.mjs test auth",
    "test:contract": "node scripts/verify/run-gates.mjs test contract",
    "test:integration": "node scripts/verify/run-gates.mjs test integration",
    "test:operations": "node scripts/verify/run-gates.mjs protected operations",
    "test:performance": "node scripts/verify/run-gates.mjs protected performance",
    "test:privacy": "node scripts/verify/run-gates.mjs test privacy",
    "test:property": "node scripts/verify/run-gates.mjs test property",
    "test:providers:real": "node scripts/verify/run-gates.mjs providers",
    "test:pwa": "node scripts/verify/run-gates.mjs test pwa",
    "test:security": "node scripts/verify/run-gates.mjs test security",
    "test:unit": "node scripts/verify/run-gates.mjs test unit",
    "typecheck": "node scripts/verify/run-gates.mjs typecheck",
    "toolchain:check": "node scripts/toolchain/check-versions.mjs",
    "verify": "node scripts/verify/run-gates.mjs verify"
  },
  "devDependencies": {
    "@cashmemo/test-support": "workspace:*",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.6.26",
    "concurrently": "10.0.4",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "globals": "17.9.0",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}

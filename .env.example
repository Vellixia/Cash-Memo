# api + worker
DATABASE_URL=postgres://cashmemo:cashmemo@localhost:5432/cashmemo
PORT=8080
COOKIE_SECURE=false
# Base URL of the web app, used in email links
APP_URL=http://localhost:3000
# GlitchTip (Sentry-compatible) DSN; unset = errors only go to stdout
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# worker: without RESEND_API_KEY, emails are logged instead of sent
# RESEND_API_KEY=
# MAIL_FROM=Cash Memo <noreply@mail.cashmemo.andresholivin.dev>
# EMAIL_DAILY_CAP=90
# web
API_URL=http://localhost:8080
# CSV export/import storage (docker-compose `s3` = MinIO locally; Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cashmemo-files
S3_ACCESS_KEY_ID=cashmemo
S3_SECRET_ACCESS_KEY=cashmemo-secret

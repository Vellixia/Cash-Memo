{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/currency-registry.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "data/registry-v1.json"],
  "exclude": ["dist"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/domain.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "tests"],
  "references": [{ "path": "../currency-registry/tsconfig.json" }]
}

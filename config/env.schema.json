{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "FINGERPRINT_KEK_PREVIOUS": ["FINGERPRINT_KEK_PREVIOUS_ID"],
    "FINGERPRINT_KEK_PREVIOUS_ID": ["FINGERPRINT_KEK_PREVIOUS"]
  },
  "required": [
    "APPWRITE_ENDPOINT",
    "APPWRITE_PROJECT_ID",
    "APPWRITE_DATABASE_ID",
    "APPWRITE_SERVER_API_KEY",
    "APPWRITE_OPENSSL_KEY",
    "APPWRITE_DB_ROOT_PASSWORD",
    "APPWRITE_DB_PASSWORD",
    "APPWRITE_CONSOLE_EMAIL",
    "APPWRITE_CONSOLE_PASSWORD",
    "FINGERPRINT_KEK_CURRENT_ID",
    "FINGERPRINT_KEK_CURRENT",
    "CURSOR_AEAD_KEY",
    "PURGE_TOKEN_KEY",
    "USER_PARTITION_KEY",
    "COOKIE_SECRET",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OPENOBSERVE_ROOT_EMAIL",
    "OPENOBSERVE_ROOT_PASSWORD",
    "OPENOBSERVE_AUTH_CREDENTIAL",
    "SUPPRESSION_S3_ACCESS_KEY",
    "SUPPRESSION_S3_SECRET_KEY"
  ],
  "properties": {
    "APP_ENV": {
      "type": "string",
      "enum": ["development", "test", "production"],
      "default": "development",
      "secret": false
    },
    "APPWRITE_ENDPOINT": { "type": "string", "format": "uri", "secret": false },
    "APPWRITE_PROJECT_ID": {
      "type": "string",
      "minLength": 1,
      "secret": false
    },
    "APPWRITE_DATABASE_ID": {
      "type": "string",
      "minLength": 1,
      "secret": false
    },
    "APPWRITE_SERVER_API_KEY": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "APPWRITE_OPENSSL_KEY": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "APPWRITE_DB_ROOT_PASSWORD": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "secret": true
    },
    "APPWRITE_DB_PASSWORD": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "secret": true
    },
    "APPWRITE_CONSOLE_EMAIL": {
      "type": "string",
      "format": "email",
      "secret": false
    },
    "APPWRITE_CONSOLE_PASSWORD": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "FINGERPRINT_KEK_CURRENT_ID": {
      "type": "string",
      "pattern": "^kek-[0-9]{8}$",
      "secret": false
    },
    "FINGERPRINT_KEK_CURRENT": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 43,
      "secret": true
    },
    "FINGERPRINT_KEK_PREVIOUS": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 43,
      "secret": true
    },
    "FINGERPRINT_KEK_PREVIOUS_ID": {
      "type": "string",
      "pattern": "^kek-[0-9]{8}$",
      "secret": false
    },
    "CURSOR_AEAD_KEY": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 43,
      "secret": true
    },
    "PURGE_TOKEN_KEY": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 43,
      "secret": true
    },
    "USER_PARTITION_KEY": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 43,
      "secret": true
    },
    "COOKIE_SECRET": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 43,
      "secret": true
    },
    "SUPPRESSION_S3_ENDPOINT": {
      "type": "string",
      "format": "uri",
      "secret": false
    },
    "SUPPRESSION_S3_ACCESS_KEY": {
      "type": "string",
      "minLength": 16,
      "secret": true
    },
    "SUPPRESSION_S3_SECRET_KEY": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "OTEL_EXPORTER_OTLP_ENDPOINT": {
      "type": "string",
      "format": "uri",
      "secret": false
    },
    "OPENOBSERVE_AUTH_CREDENTIAL": {
      "type": "string",
      "minLength": 32,
      "secret": true
    },
    "OPENOBSERVE_ROOT_EMAIL": {
      "type": "string",
      "format": "email",
      "secret": false
    },
    "OPENOBSERVE_ROOT_PASSWORD": {
      "type": "string",
      "minLength": 32,
      "secret": true
    }
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest/globals"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/server.tsbuildinfo"
  },
  "include": ["drizzle.config.ts", "src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "coverage"],
  "references": [
    { "path": "../../packages/contracts/tsconfig.json" },
    { "path": "../../packages/currency-registry/tsconfig.json" },
    { "path": "../../packages/domain/tsconfig.json" },
    { "path": "../../packages/test-support/tsconfig.json" }
  ]
}

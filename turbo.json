{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["DATABASE_URL", "PORT", "COOKIE_SECURE", "API_URL", "APP_URL", "SENTRY_DSN", "RESEND_API_KEY", "MAIL_FROM", "EMAIL_DAILY_CAP"] },
    "build": { "outputs": [".next/**", "!.next/cache/**"] },
    "test": { "cache": false, "passThroughEnv": ["DATABASE_URL"] },
    "lint": {}
  }
}
